{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListBackupPrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::srushti-cloudops-backups-4821",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["backups/", "backups/*"]
        }
      }
    },
    {
      "Sid": "ReadWriteBackupObjects",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": "arn:aws:s3:::srushti-cloudops-backups-4821/backups/*"
    }
  ]
}
